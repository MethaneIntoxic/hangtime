# Hangtime environment
# Copy to .env.local and adjust. All values have local-first defaults.

# Local development database file. Vercel never uses this fallback.
DATABASE_URL=./data/dinner-time.db

# Preview/production: remote Turso connection and database-scoped token.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Explicitly enable the local multi-user demo. Never enable this in production.
HANGTIME_DEMO_MODE=true

# Secret used to sign local demo-session cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=dev-only-secret-change-me

# Base URL used for magic-link emails (default: http://localhost:3000)
APP_URL=http://localhost:3000

# OneMap (real integration — the stub adapter ignores these)
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# MapLibre renders OpenFreeMap tiles without a browser API key.
# OneMap credentials remain server-only for future authoritative SG search/routing.

# Google Calendar OAuth (real integration — the stub adapter ignores these)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=

# Resend email for one-time production sign-in links.
RESEND_API_KEY=
AUTH_EMAIL_FROM=Hangtime <sign-in@example.com>
AUTH_EMAIL_DRIVER=resend
# Tests only; AUTH_EMAIL_DRIVER=test is rejected in production.
AUTH_TEST_EMAIL_OUTBOX_PATH=./test-results/auth-email-outbox.jsonl

# Precise profile and participant origins use an environment-specific AES-256-GCM keyring.
# Base64url-encode JSON shaped as {"active":"v1","keys":{"v1":"<32-byte-base64url-key>"}}.
# Never reuse or commit production key material.
LOCATION_KEYRING_B64=

# Web Push VAPID (real integration — the stub adapter simulates delivery)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Deployment metadata. Vercel supplies VERCEL_GIT_COMMIT_SHA automatically.
APP_REVISION=local
RELEASE_CHANNEL=preview
